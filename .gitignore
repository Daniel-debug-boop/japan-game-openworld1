# Godot import cache and generated metadata
.godot/
*.translation
*.remap

# Build outputs
builds/

# Downloaded toolchain and cached archives
.cache/
tools/bin/
Godot_v*.zip
Godot_v*.tpz
Godot_v*_linux.*
templates/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Secrets and local config
.env
.env.*
!.env.example
secrets/
*.token

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# PLATEAU converted meshes (large, generated by tools/fetch_plateau.py).
# index.json and manifest.json are committed; the .pmesh payloads are rebuilt.
assets/plateau/*/*.pmesh

# Temporary / partial downloads
*.part
*.tmp

# Local runtime diagnostics and screenshots (not shipped) — except the
# pixel-verified V1 capture evidence, which is not ignored below.
build_output/visual_diag/
build_output/screenshots/

# Do NOT ignore the V1 release package.
!release/
!release/RELEASE_NOTES.md
!release/V1_SHIPMENT_PACKAGE.md

# Do NOT ignore the already-captured pixel-verified V1 evidence.
!build_output/visual_diag/after/
!build_output/visual_diag/after/capture_report.json
!build_output/visual_diag/after/*.png
